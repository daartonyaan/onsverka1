    function renderDetail(c=state.selected){
      state.screen='detail';state.selected=c;setFormTitle(`Онлайн-сверка: ${c.name}`);
      const open=openIssues(c),resolved=resolvedIssues(c);
      content.innerHTML=`
        <button class="back-link" data-action="report">← Вернуться к общему отчёту</button>
        <div class="detail-headline"><div class="detail-title"><h1>${esc(c.name)}</h1><p>ИНН ${c.inn} / КПП ${c.kpp} · договор ${esc(c.contract)}</p></div><span>${statusMarkup(c)}</span></div>
        ${commandBar('detail')}
        <div class="compact-fields"><div class="field-label">Организация</div><div class="read-field">ООО «Вектор Про»</div><div class="field-label">Период</div><div class="read-field">${period}</div><div class="field-label">Контрагент</div><div class="read-field">${esc(c.name)}</div><div class="field-label">Договор</div><div class="read-field">${esc(c.contract)}</div></div>
        ${open.length?`<div class="notification"><span class="notification-icon">!</span><div><b>${open.length} ${open.length===1?'вопрос требует':'вопросов требуют'} проверки</b><p>Система показывает найденные несоответствия, но не изменяет документы и проводки 1С. После исправления выполните обмен с Диадоком, если менялся электронный документ, и пересчитайте сверку.</p></div></div>`:`<div class="notification ok"><span class="notification-icon">✓</span><div><b>${resolved.length?'Все найденные вопросы обработаны':'Расхождений не найдено'}</b><p>Данные готовы для создания акта сверки в 1С и последующей отправки через Диадок.</p></div></div>`}
        ${detailTotals(c)}
        <div class="form-pages"><button class="page-tab ${state.tab==='questions'?'active':''}" data-tab="questions">Вопросы (${allIssues(c).length})</button><button class="page-tab ${state.tab==='journal'?'active':''}" data-tab="journal">Журнал взаиморасчётов</button><button class="page-tab ${state.tab==='act'?'active':''}" data-tab="act">Акт сверки</button><button class="page-tab ${state.tab==='history'?'active':''}" data-tab="history">История решений</button></div>
        <div class="page-body" id="detailBody"></div>`;
      renderDetailTab(c);
      setStatus(`${c.name} · данные на ${state.dataTime}`);
    }

    function renderDetailTab(c){
      const body=document.getElementById('detailBody');if(!body)return;
      if(state.tab==='journal')return renderJournal(c,body);
      if(state.tab==='act')return renderAct(c,body);
      if(state.tab==='history')return renderHistory(c,body);
      const issues=allIssues(c),open=openIssues(c),resolved=resolvedIssues(c);
      body.innerHTML=`<div class="section-actions"><button class="cmd" data-action="recalculate">↻ Пересчитать</button><span class="command-separator"></span><span>Открыто: <b>${open.length}</b> · обработано: <b>${resolved.length}</b></span><span class="right small-note">Откройте вопрос, чтобы увидеть сравнение и действие</span></div>
        ${issues.length?`<div class="table-box"><table class="data-table"><thead><tr><th style="width:17%">Состояние</th><th style="width:20%">Документ</th><th style="width:34%">Что обнаружено</th><th>Дата</th><th class="num">Влияние, ₽</th><th>Решение</th></tr></thead><tbody>${issues.map(x=>{const res=state.resolutions.get(x.id),done=res&&!res.pending;return`<tr data-issue-row="${x.id}"><td>${done?'<span class="status ok">Обработано</span>':res?.pending?'<span class="status warn">Ожидает пересчёта</span>':`<span class="status ${x.severity}">${issueLabels[x.code]}</span>`}</td><td><button class="doc-link" data-action="open-issue" data-issue="${x.id}">${esc(x.doc)}</button></td><td>${esc(x.short)}</td><td>${x.date}</td><td class="num">${fmt(x.impact)}</td><td>${res?`${esc(res.label)}<div class="muted">${esc(res.comment||'Без комментария')}</div>`:'—'}</td></tr>`}).join('')}</tbody></table></div>`:`<div class="empty-state"><div><b>Расхождений нет</b><p>Документы и операции по выбранным параметрам сопоставлены.</p></div></div>`}`;
    }

    function journalRows(c){
      const t=turns(c),base1=118000+c.seed*1300,base2=76000+c.seed*850,pay=Math.round((base1+base2)*.58);
      const rows=[
        {date:'01.08.2026',doc:'Сальдо начальное',kind:'Остаток',debit:Math.max(0,t.opening),credit:Math.max(0,-t.opening),d:'—',o:'Учтено',result:'Перенесено'},
        {date:'04.08.2026',doc:`УПД № ${c.seed}04`,kind:'Реализация',debit:base1,credit:0,d:'Подписан',o:'Проведён',result:'Сошлось'},
        {date:'10.08.2026',doc:`Акт № ${c.seed}-18`,kind:'Оказание услуг',debit:base2,credit:0,d:'Подписан',o:'Проведён',result:'Сошлось'},
        {date:'15.08.2026',doc:`Платёжное поручение № ${1700+c.seed}`,kind:'Оплата',debit:0,credit:pay,d:'Не требуется',o:'Проведён',result:'Учтено'}
      ];
      allIssues(c).forEach(x=>rows.push({date:x.date,doc:x.doc,kind:issueLabels[x.code],debit:['correction','payment'].includes(x.code)?0:x.impact,credit:['correction','payment'].includes(x.code)?x.impact:0,d:['missing_1c','unsigned','correction','amount','period'].includes(x.code)?'Найден':'Не найден',o:x.code==='missing_1c'?'Не найден':'Проведён',result:state.resolutions.has(x.id)?'Обработано':'Проверить',issueId:x.id}));
      return rows.sort((a,b)=>a.date.split('.').reverse().join('').localeCompare(b.date.split('.').reverse().join('')));
    }

    function renderJournal(c,body){
      const rows=journalRows(c);
      body.innerHTML=`<div class="section-actions"><button class="cmd" data-action="export-csv">Сохранить в файл</button><button class="cmd" data-action="print-report">Печать</button><span class="right small-note">Документы Диадока не дублируют движения: финансовый эффект берётся из 1С</span></div><div class="table-box"><table class="data-table"><thead><tr><th>Дата</th><th style="width:25%">Документ / операция</th><th>Вид операции</th><th>Диадок</th><th>Данные 1С</th><th class="num">Дебет, ₽</th><th class="num">Кредит, ₽</th><th>Результат</th></tr></thead><tbody>${rows.map(r=>`<tr><td>${r.date}</td><td>${r.issueId?`<button class="doc-link" data-action="open-issue" data-issue="${r.issueId}">${esc(r.doc)}</button>`:esc(r.doc)}</td><td>${esc(r.kind)}</td><td>${r.d}</td><td>${r.o}</td><td class="num">${r.debit?num(r.debit):'—'}</td><td class="num">${r.credit?num(r.credit):'—'}</td><td>${r.result==='Сошлось'||r.result==='Учтено'||r.result==='Перенесено'||r.result==='Обработано'?`<span class="status ok">${r.result}</span>`:'<span class="status warn">Проверить</span>'}</td></tr>`).join('')}</tbody></table></div>`;
    }

    function renderAct(c,body){
      const open=openIssues(c),rows=journalRows(c),t=turns(c),ready=!open.length,created=state.createdActs.has(c.id),beneficiary=c.balance>=0?'ООО «Вектор Про»':c.name;
      body.innerHTML=`<div class="section-actions"><button class="cmd primary" data-action="create-act">${created?'Обновить акт в 1С':'Создать акт сверки в 1С'}</button>${created?'<button class="cmd" data-action="open-act-onec">Открыть акт в 1С</button><button class="cmd" data-action="open-outgoing">Перейти к отправке в Диадоке</button>':''}${open.length?'<button class="cmd" data-action="questions">Перейти к вопросам</button>':''}<span class="right">${created?'<span class="status ok">Документ 1С создан</span>':ready?'<span class="status ok">Готов к созданию</span>':'<span class="status warn">Предварительный</span>'}</span></div>
        ${ready?'<div class="notification ok"><span class="notification-icon">✓</span><div><b>Данные готовы для создания акта сверки в 1С</b><p>Ответ контрагента и двусторонний протокол разногласий не входят в первую версию.</p></div></div>':`<div class="notification"><span class="notification-icon">!</span><div><b>Предварительные данные: открыто вопросов — ${open.length}</b><p>Акт можно создать с предупреждением, но открытые вопросы останутся отмеченными.</p></div></div>`}
        <div class="act-layout"><article class="act-sheet"><header><h2>Данные для акта сверки взаимных расчётов</h2><p>за период с 01.08.2026 по 31.08.2026</p><p>между ООО «Вектор Про» и ${esc(c.name)}</p></header><table><thead><tr><th>Дата</th><th>Документ / операция</th><th class="num">Дебет, ₽</th><th class="num">Кредит, ₽</th><th>Проверка</th></tr></thead><tbody>${rows.map(r=>{const issue=r.issueId?allIssues(c).find(x=>x.id===r.issueId):null,res=issue?state.resolutions.get(issue.id):null;return`<tr><td>${r.date}</td><td>${esc(r.doc)}</td><td class="num">${r.debit?num(r.debit):''}</td><td class="num">${r.credit?num(r.credit):''}</td><td>${issue?(res?.pending?'Ожидает пересчёта':res?'Обработано':'Требует проверки'):'Сошлось'}</td></tr>`}).join('')}<tr class="act-total"><td colspan="2">Обороты за период</td><td class="num">${num(t.debit)}</td><td class="num">${num(t.credit)}</td><td></td></tr><tr class="act-total"><td colspan="2">Сальдо на 31.08.2026</td><td colspan="2" class="num">${balanceText(c)}</td><td></td></tr></tbody></table><p class="act-conclusion">По данным ООО «Вектор Про» задолженность в пользу ${esc(beneficiary)} составляет <b>${fmt(c.balance)}.</b></p><p class="small-note">После создания данные записываются в штатный документ 1С «Акт сверки расчётов». Отправка выполняется через пакет Диадока.</p></article><aside class="act-side"><h3>Передача в штатный процесс</h3><dl><dt>Организация</dt><dd>ООО «Вектор Про»</dd><dt>Контрагент</dt><dd>${esc(c.name)}</dd><dt>Период</dt><dd>${period}</dd><dt>Договор</dt><dd>${esc(c.contract)}</dd><dt>Документ 1С</dt><dd>${created?'Создан':'Ещё не создан'}</dd><dt>Открытые вопросы</dt><dd>${open.length}</dd><dt>Следующий шаг</dt><dd>${created?'Раздел «Для отправки»':'Создать акт сверки в 1С'}</dd></dl></aside></div>`;
    }

    function historyEvents(c){
      const dynamic=state.history[c.id]||[];
      const base=[{time:'01.09.2026 09:45',action:'Выполнена проверка',detail:`Сопоставлено операций: ${c.matched+allIssues(c).length}`},...allIssues(c).map((x,i)=>({time:`01.09.2026 09:${String(43-i).padStart(2,'0')}`,action:'Найден вопрос',detail:`${x.title}: ${x.doc}`}))];
      return[...dynamic,...base];
    }
    function renderHistory(c,body){
      const events=historyEvents(c);
      body.innerHTML=`<div class="section-actions"><span>Фиксируются результаты проверок и решения пользователя внутри модуля.</span></div><div class="table-box"><table class="data-table"><thead><tr><th style="width:160px">Дата и время</th><th style="width:190px">Действие</th><th>Описание</th><th style="width:150px">Пользователь</th></tr></thead><tbody>${events.map(e=>`<tr><td>${e.time}</td><td>${esc(e.action)}</td><td>${esc(e.detail)}</td><td>Дарья Крылова</td></tr>`).join('')}</tbody></table></div><p class="small-note">Изменения в электронных документах появятся после обмена с Диадоком, изменения учёта — после пересчёта.</p>`;
    }

    function findIssue(id){for(const c of counterparties){const x=allIssues(c).find(i=>i.id===id);if(x)return{x,c}}return null}
    function evidenceAction(x,e,index){
      const isDiadoc=e[0].includes('Диадок');
      if(x.code==='missing_1c'&&!isDiadoc)return{source:'onec-list',label:'Открыть список операций 1С'};
      if(x.code==='missing_diadoc'&&isDiadoc)return{source:'diadoc-list',label:'Открыть список документов'};
      if(x.code==='payment'&&index===1)return{source:'variants',label:'Показать варианты'};
      return{source:isDiadoc?'diadoc':'onec',label:isDiadoc?'Открыть карточку Диадока':'Открыть документ 1С'};
    }
    function issueLink(x){
      if(state.links.has(x.id))return state.links.get(x.id);
      if(['amount','period','correction'].includes(x.code))return{label:'Сопоставлено модулем',basis:'Организация, контрагент, дата и номер'};
      return null;
    }
    function linkMarkup(x){
      if(['unsigned','partial'].includes(x.code))return'';
      const link=issueLink(x),payment=x.code==='payment';
      return`<div class="dialog-group"><div class="dialog-group-title">${payment?'Связь оплаты с документами':'Связь документа 1С и Диадока'}</div><div class="dialog-group-content"><p>${link?`<span class="state-ok">✓ ${esc(link.label)}</span> · ${esc(link.basis)}`:'<span class="state-warn">Связь не определена</span>'}</p><div style="display:flex;gap:7px;margin-top:8px;flex-wrap:wrap">${link?`<button class="cmd" data-action="unlink-docs" data-issue="${x.id}">Отвязать</button>`:`<button class="cmd" data-action="auto-match" data-issue="${x.id}">${payment?'Подобрать автоматически':'Сопоставить автоматически'}</button><button class="cmd" data-action="manual-match" data-issue="${x.id}">${payment?'Выбрать документы вручную':'Сопоставить вручную'}</button>`}</div><p class="small-note">Сначала используется сохранённая связь. Если её нет, модуль ищет совпадение по организации, контрагенту, дате и номеру; неоднозначный результат подтверждает бухгалтер.</p></div></div>`;
    }
    function openIssue(id){
      const found=findIssue(id);if(!found)return;const{x,c}=found,res=state.resolutions.get(x.id);
      overlayRoot.innerHTML=`<div class="overlay"><section class="dialog" role="dialog" aria-modal="true" aria-label="Вопрос сверки"><header class="dialog-title"><h2>Вопрос сверки: ${esc(x.doc)}</h2><button class="dialog-close" data-action="close-dialog" aria-label="Закрыть">×</button></header><div class="dialog-body">
        <div class="dialog-group"><div class="dialog-group-title">Что обнаружено</div><div class="dialog-group-content"><dl class="finding"><dt>Состояние</dt><dd><span class="status ${res?.pending?'warn':res?'ok':x.severity}">${res?.pending?'Ожидает пересчёта':res?'Обработано':issueLabels[x.code]}</span></dd><dt>Контрагент</dt><dd>${esc(c.name)}</dd><dt>Описание</dt><dd>${esc(x.short)}</dd><dt>Влияние</dt><dd><b>${fmt(x.impact)}</b></dd><dt>Правило проверки</dt><dd>${esc(x.rule)}</dd></dl></div></div>
        <div class="dialog-group"><div class="dialog-group-title">Сравнение данных</div><div class="dialog-group-content"><table class="comparison"><thead><tr><th>Источник</th><th>Значение</th><th>Состояние</th><th>Открыть</th></tr></thead><tbody>${x.evidence.map((e,i)=>{const a=evidenceAction(x,e,i);return`<tr><td>${esc(e[0])}</td><td><strong>${esc(e[1])}</strong></td><td>${esc(e[2])}</td><td><button class="company-link" data-action="open-source" data-source="${a.source}">${a.label}</button></td></tr>`}).join('')}</tbody></table></div></div>
        ${linkMarkup(x)}
        ${res?`<div class="result-box ${res.pending?'pending':''}"><b>${esc(res.pending?'Ожидает пересчёта':res.label)}</b><p>${esc(res.comment||'Комментарий не указан')}</p><small>Дарья Крылова · ${res.at}</small></div>`:`<div class="dialog-group"><div class="dialog-group-title">Рекомендуемое действие</div><div class="dialog-group-content"><div class="recommendation"><span>!</span><p>${esc(x.action)}</p></div><label class="comment-label" for="resolutionComment" style="margin-top:10px">Комментарий</label><textarea id="resolutionComment" placeholder="Укажите основание решения. Для допустимого расхождения и учёта другим способом комментарий обязателен."></textarea><div class="validation" id="commentValidation"></div></div></div>`}
      </div><footer class="dialog-footer"><span class="footer-note">Решение сохраняется в истории. Документы 1С автоматически не изменяются.</span>${res?`${res.pending?'<button class="cmd primary" data-action="recalculate">Пересчитать</button>':''}<button class="cmd" data-action="reopen-issue" data-issue="${x.id}">Вернуть в работу</button>`:`<button class="cmd" data-action="resolve" data-type="verified" data-issue="${x.id}">Расхождение допустимо</button><button class="cmd" data-action="resolve" data-type="other" data-issue="${x.id}">Учтено другим способом</button><button class="cmd primary" data-action="resolve" data-type="fixed" data-issue="${x.id}">Исправлено в 1С или Диадоке</button>`}<button class="cmd" data-action="close-dialog">Закрыть</button></footer></section></div>`;
    }

    function resolveIssue(id,type){
      const found=findIssue(id);if(!found)return;const comment=document.getElementById('resolutionComment')?.value.trim()||'';
      if(['other','verified'].includes(type)&&!comment){const validation=document.getElementById('commentValidation');document.getElementById('resolutionComment').classList.add('error');validation.textContent=type==='verified'?'Добавьте комментарий: почему расхождение является допустимым.':'Добавьте комментарий: как именно операция учтена.';validation.classList.add('visible');document.getElementById('resolutionComment').focus();return}
      const labels={fixed:'Исправлено в 1С или Диадоке',verified:'Расхождение допустимо',other:'Учтено другим способом'};
      const savedComment=comment||(type==='fixed'?'Пользователь отметил исправление. Требуется пересчитать сверку.':'Допустимое расхождение подтверждено пользователем.');
      state.resolutions.set(id,{type,label:labels[type],comment:savedComment,at:'01.09.2026 10:12',pending:type==='fixed'});
      state.history[found.c.id]=state.history[found.c.id]||[];
      state.history[found.c.id].unshift({time:'01.09.2026 10:12',action:labels[type],detail:`${found.x.doc}: ${savedComment}`});
      overlayRoot.innerHTML='';toast(labels[type],'Решение сохранено в истории');
      state.screen==='detail'?renderDetail(found.c):renderReport();
    }

    function confirmPendingResolutions(){
      state.resolutions.forEach((resolution,id)=>{
        if(!resolution.pending)return;
        resolution.pending=false;
        const found=findIssue(id);if(!found)return;
        state.history[found.c.id]=state.history[found.c.id]||[];
        state.history[found.c.id].unshift({time:'01.09.2026 10:15',action:'Исправление подтверждено',detail:`${found.x.doc}: повторная проверка расхождение не обнаружила`});
      });
    }

    function reopenIssue(id){
      const found=findIssue(id);if(!found)return;state.resolutions.delete(id);state.history[found.c.id]=state.history[found.c.id]||[];state.history[found.c.id].unshift({time:'01.09.2026 10:14',action:'Вопрос возвращён в работу',detail:found.x.doc});overlayRoot.innerHTML='';toast('Вопрос возвращён в работу');renderDetail(found.c);
    }

    function openExchange(){
      overlayRoot.innerHTML=`<div class="overlay"><section class="dialog small" role="dialog" aria-modal="true"><header class="dialog-title"><h2 id="syncTitle">Обмен с Диадоком</h2><button class="dialog-close" data-action="close-dialog">×</button></header><div class="dialog-body"><p>Модуль получит новые и изменившиеся электронные документы и актуальные статусы документооборота.</p><div class="sync-steps"><div class="sync-step" data-step="0"><span class="step-icon">1</span><div><b>Получение данных с сервера</b><small>Документы выбранной организации и доступных подразделений</small></div></div><div class="sync-step" data-step="1"><span class="step-icon">2</span><div><b>Сохранение в информационной базе</b><small>XML, статусы, подписи и связи корректировок</small></div></div></div><div class="progress"><i id="syncProgress"></i></div><p class="small-note" id="syncNote">Последний обмен: ${state.exchangeTime}</p></div><footer class="dialog-footer"><button class="cmd" data-action="close-dialog">Отмена</button><button class="cmd primary" data-action="start-exchange" id="startSync">Выполнить обмен</button></footer></section></div>`;
    }

    function startExchange(){
      const btn=document.getElementById('startSync');if(!btn)return;btn.disabled=true;btn.textContent='Обмен…';
      const progress=document.getElementById('syncProgress'),note=document.getElementById('syncNote'),title=document.getElementById('syncTitle');
      [0,1].forEach((n,i)=>setTimeout(()=>{
        const row=document.querySelector(`[data-step="${n}"]`);if(!row)return;
