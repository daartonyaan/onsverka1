      if(x.code==='missing_diadoc')return'<button class="inline-action" data-action="open-source-list" data-side="dd">Проверить документы Диадока</button>; документ может находиться вне Диадока.';
      if(x.code==='amount')return'Проверить, какая сумма верна. Если верны данные 1С — оформить исправленный документ, УКД или аннулирование в Диадоке; если верен подписанный документ — <button class="inline-action" data-action="open-source" data-side="onec">исправить документ в 1С</button>.';
      if(x.code==='period')return'Проверить дату отражения в 1С. Если перенос периода корректен, выбрать «Расхождение допустимо».';
      if(x.code==='unsigned')return'<button class="inline-action" data-action="open-source" data-side="dd">Перейти к документу Диадока</button> и проверить подписание.';
      return'<button class="inline-action" data-action="open-source" data-side="onec">Проверить корректировку в 1С</button> и связанный УКД.';
    }
    function openIssue(id){
      const found=getIssue(id);if(!found)return;const{c,issue:x}=found,r=resolution(id);
      overlayRoot.innerHTML=`<div class="overlay"><section class="dialog" role="dialog" aria-modal="true"><header class="dialog-title"><h2>${esc(issueNames[x.code])}</h2><button class="dialog-close" data-action="close">×</button></header><div class="dialog-body">
        <dl class="issue-summary"><dt>Контрагент</dt><dd>${esc(c.name)}</dd><dt>Роль КА</dt><dd>${roleMeta[c.contracts.find(contract=>contract.id===x.contract)?.role]?.title||'—'}</dd><dt>Договор</dt><dd>${esc(getContract(c,x.contract))}</dd><dt>Направление</dt><dd>${directionMarkup(x.direction)}</dd><dt>Что обнаружено</dt><dd>${esc(x.summary)}</dd><dt>Что сделать</dt><dd class="action-cell">${contextualActions(x)}</dd></dl>
        <div class="compare-grid">${sourceCard(x,'dd')}${sourceCard(x,'onec')}</div>
        ${r?`<div class="result-box ${r.pending?'pending':''}" style="margin-top:9px"><b>${esc(r.pending?'Ожидает повторной проверки':r.label)}</b><p>${esc(r.comment)}</p><small>Дарья Крылова · ${r.at}</small></div>`:`<div style="margin-top:9px"><label class="comment-label" for="resolutionComment">Комментарий ${x.code==='period'?'':'к решению'}</label><textarea id="resolutionComment" placeholder="Для допустимого расхождения укажите основание"></textarea><div class="validation" id="commentValidation"></div></div>`}
        </div><footer class="dialog-footer"><span class="footer-note">Решение сохранится в истории. Документы 1С автоматически не изменяются.</span>${r?`${r.pending?'<button class="cmd primary" data-action="check">Выполнить повторную проверку</button>':''}<button class="cmd" data-action="reopen" data-issue="${x.id}">Вернуть в работу</button>`:`<button class="cmd" data-action="resolve" data-type="acceptable" data-issue="${x.id}">Расхождение допустимо</button><button class="cmd primary" data-action="resolve" data-type="fixed" data-issue="${x.id}">Исправлено</button>`}<button class="cmd" data-action="close">Закрыть</button></footer></section></div>`;
    }
    function resolveIssue(id,type){
      const found=getIssue(id);if(!found)return;const comment=document.getElementById('resolutionComment')?.value.trim()||'';
      if(type==='acceptable'&&!comment){const v=document.getElementById('commentValidation');v.textContent='Укажите, почему расхождение допустимо.';v.classList.add('visible');document.getElementById('resolutionComment').classList.add('error');return}
      const label=type==='fixed'?'Исправлено':'Расхождение допустимо',saved=comment||(type==='fixed'?'Пользователь отметил исправление. Нужна повторная проверка.':'Допустимое расхождение подтверждено.');
      state.resolutions.set(id,{label,comment:saved,pending:type==='fixed',at:'01.09.2026 10:12'});
      state.history[found.c.id]=state.history[found.c.id]||[];state.history[found.c.id].unshift({time:'01.09.2026 10:12',action:label,detail:`${issueNames[found.issue.code]}: ${saved}`,contract:found.issue.contract});
      closeOverlay();renderDetail(found.c);toast(label,'Решение сохранено в истории');
    }

    function openSettings(){
      overlayRoot.innerHTML=`<div class="overlay"><section class="dialog small"><header class="dialog-title"><h2>Параметры проверки</h2><button class="dialog-close" data-action="close">×</button></header><div class="dialog-body"><p style="margin-bottom:8px">В первой версии состав проверок фиксирован и не изменяется пользователем.</p><div class="check-list">${['Сопоставление документов 1С и Диадока','Проверка сумм','Проверка дат и периодов отражения','Проверка штатных статусов Диадока','Исправления и корректировки','Оплаты, возвраты, взаимозачёты и сторно из 1С'].map(x=>`<div class="check-row"><span class="check-mark">✓</span><span>${x}</span><span class="check-status">Проверяется</span></div>`).join('')}</div><p class="small-note">Подразделения, склады и объекты расчётов учитываются по данным 1С.</p></div><footer class="dialog-footer"><button class="cmd primary" data-action="close">Закрыть</button></footer></section></div>`;
    }
    function openPeriod(){
      overlayRoot.innerHTML=`<div class="overlay"><section class="dialog small"><header class="dialog-title"><h2>Период проверки</h2><button class="dialog-close" data-action="close">×</button></header><div class="dialog-body"><div class="compact-fields" style="grid-template-columns:90px 1fr"><div class="field-label">Дата начала</div><div class="field"><input id="periodFrom" value="01.08.2026"></div><div class="field-label">Дата окончания</div><div class="field"><input id="periodTo" value="31.08.2026"></div></div><div class="notification"><span class="notification-icon">!</span><div><b>Период не ограничен</b><p>Проверка большого объёма документов может занять больше времени.</p></div></div></div><footer class="dialog-footer"><button class="cmd" data-action="close">Отмена</button><button class="cmd primary" data-action="apply-period">Применить</button></footer></section></div>`;
    }
    function openProgress(){
      const steps=['Получение изменений из Диадока','Чтение проведённых операций 1С','Сопоставление документов','Расчёт сальдо и расхождений'];
      overlayRoot.innerHTML=`<div class="overlay"><section class="dialog small"><header class="dialog-title"><h2>Проверка взаиморасчётов</h2><button class="dialog-close" data-action="close">×</button></header><div class="dialog-body"><p>Модуль обновит документы и статусы Диадока, прочитает операции 1С и пересчитает результаты.</p><div class="sync-steps">${steps.map((x,i)=>`<div class="sync-step" data-step="${i}"><span class="step-icon">${i+1}</span><div><b>${x}</b><small>Ожидает выполнения</small></div></div>`).join('')}</div><div class="progress"><i id="syncProgress"></i></div><p class="small-note" id="syncNote">Операция ещё не запущена</p></div><footer class="dialog-footer"><button class="cmd flat" data-action="show-error">Показать состояние ошибки</button><button class="cmd" data-action="close">Отмена</button><button class="cmd primary" data-action="start-progress" id="startProgress">Начать</button></footer></section></div>`;
    }
    function startProgress(){
      const steps=[...document.querySelectorAll('.sync-step')],bar=document.getElementById('syncProgress'),note=document.getElementById('syncNote'),btn=document.getElementById('startProgress');btn.disabled=true;btn.textContent='Выполняется…';setStatus('Выполняется проверка','busy');
      steps.forEach((step,i)=>setTimeout(()=>{steps.forEach(s=>s.classList.remove('processing'));step.classList.add('processing');step.querySelector('small').textContent='Выполняется';bar.style.width=`${Math.round((i+.65)/steps.length*100)}%`;if(i) {steps[i-1].classList.remove('processing');steps[i-1].classList.add('done');steps[i-1].querySelector('.step-icon').textContent='✓';steps[i-1].querySelector('small').textContent='Выполнено'}},i*500));
      setTimeout(()=>{const last=steps.at(-1);last.classList.remove('processing');last.classList.add('done');last.querySelector('.step-icon').textContent='✓';last.querySelector('small').textContent='Выполнено';bar.style.width='100%';note.innerHTML='<span class="state-ok">✓ Операция успешно завершена</span>';btn.textContent='Закрыть';btn.disabled=false;btn.dataset.action='finish-progress'},steps.length*500+250);
    }
    function showProgressError(){
      overlayRoot.innerHTML=`<div class="overlay"><section class="dialog small"><header class="dialog-title"><h2>Проверка не выполнена</h2><button class="dialog-close" data-action="close">×</button></header><div class="dialog-body"><div class="notification danger"><span class="notification-icon">!</span><div><b>Не удалось получить данные</b><p>Проверьте подключение и повторите операцию. Ранее рассчитанные результаты сохранены.</p></div></div></div><footer class="dialog-footer"><button class="cmd" data-action="close">Закрыть</button><button class="cmd primary" data-action="retry-progress">Повторить</button></footer></section></div>`;setStatus('Последняя операция завершилась ошибкой','error');
    }
    function finishProgress(){
      state.lastCheck=currentTimestamp();state.resolutions.forEach(r=>{if(r.pending)r.pending=false});
      closeOverlay();state.screen==='detail'?renderDetail(state.selected):renderReport();toast('Проверка завершена','Исправленные расхождения перепроверены');
    }
    function counterpartyChooser(){
      overlayRoot.innerHTML=`<div class="overlay"><section class="dialog"><header class="dialog-title"><h2>Выбор контрагента из справочника 1С</h2><button class="dialog-close" data-action="close">×</button></header><div class="dialog-body"><label class="choice-search">⌕ <input id="choiceSearch" placeholder="Название, ИНН или КПП"></label><div class="choice-table-box"><table class="data-table"><thead><tr><th>Контрагент</th><th>ИНН</th><th>КПП</th><th>Договоров</th><th></th></tr></thead><tbody><tr data-choice-row data-search="все контрагенты"><td><b>Все контрагенты</b></td><td>—</td><td>—</td><td>—</td><td><button class="inline-action" data-action="select-cp" data-cp="all">Выбрать</button></td></tr>${counterparties.map(c=>`<tr data-choice-row data-search="${esc(`${c.name} ${c.inn} ${c.kpp}`.toLowerCase())}"><td>${esc(c.name)}</td><td>${c.inn}</td><td>${c.kpp}</td><td>${c.contracts.length}</td><td><button class="inline-action" data-action="select-cp" data-cp="${c.id}">Выбрать</button></td></tr>`).join('')}</tbody></table></div></div><footer class="dialog-footer"><button class="cmd" data-action="close">Отмена</button></footer></section></div>`;
    }
    function prepareSend(c){const {contract}=ensureScope(c);state.sentActs.add(actKey(c,contract));renderDetail(c);toast('Акт подписан и отправлен',`Договор ${contract.label}`)}
    function bindSearch(){document.getElementById('reportSearch')?.addEventListener('input',e=>{state.search=e.target.value;renderReport()});document.getElementById('counterpartyParam')?.addEventListener('change',e=>{state.counterpartyFilter=e.target.value;renderReport()})}

    document.addEventListener('click',e=>{
      const target=e.target.closest('[data-action]');if(!target)return;const action=target.dataset.action;
      if(action==='close')return closeOverlay();
      if(action==='report')return renderReport();
      if(action==='open-cp'){const c=getCounterparty(target.dataset.cp);if(target.dataset.tabTarget)state.tab=target.dataset.tabTarget;return renderDetail(c)}
      if(action==='open-scope'){const c=getCounterparty(target.dataset.cp);state.activeRoles[c.id]=target.dataset.role;state.activeContracts[c.id]=target.dataset.contract;return renderDetail(c)}
      if(action==='set-role'){const c=state.selected,role=target.dataset.role;state.activeRoles[c.id]=role;state.activeContracts[c.id]=roleContracts(c,role)[0].id;return renderDetail(c)}
      if(action==='toggle-cp'){const id=target.dataset.cp;state.expanded.has(id)?state.expanded.delete(id):state.expanded.add(id);return renderReport()}
      if(action==='expand-all'){counterparties.forEach(c=>state.expanded.add(c.id));return renderReport()}
      if(action==='collapse-all'){state.expanded.clear();return renderReport()}
      if(action==='toggle-contract'){const key=target.dataset.key;state.expandedContracts.has(key)?state.expandedContracts.delete(key):state.expandedContracts.add(key);return renderDetail(state.selected)}
      if(action==='toggle-source'){state.sourceOpen=!state.sourceOpen;return renderReport()}
      if(action==='settings')return openSettings();
      if(action==='period')return openPeriod();
      if(action==='apply-period'){const from=document.getElementById('periodFrom').value,to=document.getElementById('periodTo').value;state.period=`${from} — ${to}`;closeOverlay();return state.screen==='detail'?renderDetail(state.selected):renderReport()}
      if(action==='choose-counterparty')return counterpartyChooser();
      if(action==='select-cp'){const c=getCounterparty(target.dataset.cp);state.counterpartyFilter=c?c.name:'';closeOverlay();return renderReport()}
      if(action==='clear-counterparty'){state.counterpartyFilter='';return renderReport()}
      if(action==='check-source')return startSourceCheck(target.dataset.source);
      if(action==='check')return openProgress();
      if(action==='start-progress')return startProgress();
      if(action==='finish-progress')return finishProgress();
      if(action==='show-error')return showProgressError();
      if(action==='retry-progress')return openProgress();
      if(action==='open-issue')return openIssue(target.dataset.issue);
      if(action==='resolve')return resolveIssue(target.dataset.issue,target.dataset.type);
      if(action==='reopen'){const found=getIssue(target.dataset.issue);state.resolutions.delete(target.dataset.issue);closeOverlay();return renderDetail(found.c)}
      if(action==='act-tab'){state.tab='act';return renderDetail(state.selected)}
      if(action==='create-act'){const c=state.selected,{contract}=ensureScope(c);state.createdActs.add(actKey(c,contract));renderDetail(c);return toast('Формализованный акт создан',`Договор ${contract.label}`)}
      if(action==='prepare-send')return prepareSend(state.selected);
      if(action==='print-act')return window.print();
      if(action==='open-act')return toast('Открывается документ 1С','Формализованный акт сверки');
      if(action==='open-source')return toast(target.dataset.side==='dd'?'Открывается документ Диадока':'Открывается документ 1С','Переход выполняется в текущей информационной базе');
      if(action==='open-source-list')return toast(target.dataset.side==='dd'?'Открывается список документов Диадока':'Открывается стандартный список документов 1С','Отбор установлен по контрагенту, договору и периоду');
      if(action==='request-correction')return toast('Создаётся запрос на корректировку','Действие продолжится в карточке документа Диадока');
      if(action==='export')return toast('Журнал сохранён','Файл подготовлен по текущему отбору');
      if(action==='field-info')return toast('Выбор организации','Открывается стандартная форма выбора 1С');
      if(action==='plugins')return toast('Плагины модуля Диадока');
      if(action==='external-nav')return toast(`Открывается раздел «${target.dataset.section}»`,'В прототипе подробно проработан сценарий онлайн-сверки');
      if(action==='global-menu')return toast('Главное меню 1С');
      if(action==='toast-help')return toast('Справка по онлайн-сверке','Проверка своей позиции и формирование формализованного акта');
      if(action==='toast-notifications')return toast('Оповещения',`${counterparties.filter(c=>openIssues(c).length).length} контрагентов требуют внимания`,'warn');
      if(action==='toast-user')return toast('Текущий пользователь','Дарья Крылова · ООО «Вектор Про»');
    });
    document.addEventListener('click',e=>{const tab=e.target.closest('[data-tab]');if(tab){state.tab=tab.dataset.tab;renderDetail(state.selected)}const filter=e.target.closest('[data-filter]');if(filter){state.filter=filter.dataset.filter;renderReport()}});
    document.addEventListener('change',e=>{if(e.target.id==='contractChoice'&&state.selected){state.activeContracts[state.selected.id]=e.target.value;renderDetail(state.selected)}});
    document.addEventListener('dblclick',e=>{const row=e.target.closest('[data-row-cp]');if(row)renderDetail(getCounterparty(row.dataset.rowCp))});
    document.addEventListener('input',e=>{if(e.target.id==='choiceSearch'){const q=e.target.value.trim().toLowerCase();document.querySelectorAll('[data-choice-row]').forEach(r=>r.hidden=q&&!r.dataset.search.includes(q))}});
    document.addEventListener('keydown',e=>{if(e.key==='Escape')closeOverlay()});

    updateToSendCount();renderReport();
  })();
  </script>
</body>
</html>
