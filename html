<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Онлайн-сверка — итоговый прототип модуля Диадока для 1С</title>
  <meta name="description" content="Интерактивный прототип Онлайн-сверки внутри модуля Контур.Диадок для 1С.">
  <style>
    :root{
      --ui-font:Arial,"Segoe UI",sans-serif;
      --app-bg:#eef0f3;
      --surface:#fff;
      --surface-2:#f6f7f8;
      --surface-3:#e8ebef;
      --line:#c5c9ce;
      --line-soft:#dde0e4;
      --text:#25272a;
      --muted:#656a70;
      --link:#1769aa;
      --link-hover:#0c4f86;
      --select:#fff3bf;
      --select-strong:#f8e58a;
      --yellow:#f4d96b;
      --yellow-hover:#efd052;
      --yellow-line:#c7ad44;
      --ok:#2f7d46;
      --ok-bg:#e8f3ea;
      --warn:#986711;
      --warn-bg:#fff4d7;
      --danger:#a43b36;
      --danger-bg:#fbe8e6;
      --shadow:0 8px 28px rgba(36,42,48,.22);
      --radius:3px;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{margin:0;overflow:hidden;background:var(--app-bg);color:var(--text);font:12px/1.32 var(--ui-font);-webkit-font-smoothing:antialiased}
    button,input,select,textarea{font:inherit;color:inherit}
    button{cursor:pointer}
    button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,[tabindex]:focus-visible{outline:2px solid #3489ca;outline-offset:1px}
    a,.link{color:var(--link);text-decoration:none}
    a:hover,.link:hover{color:var(--link-hover);text-decoration:underline}
    .hidden{display:none!important}

    /* Каркас 1С */
    .application{display:grid;height:100vh;grid-template-rows:38px 38px 1fr 24px;background:var(--app-bg)}
    .global-bar{display:flex;align-items:center;gap:9px;border-bottom:1px solid #c9b75f;background:#f5df83;padding:0 10px;color:#28230d}
    .app-logo{display:grid;width:36px;height:26px;place-items:center;border:1px solid rgba(86,72,13,.38);border-radius:2px;background:#fff7cf;font-weight:800;letter-spacing:-1px}
    .global-title{font-weight:700;white-space:nowrap}
    .global-spacer{flex:1}
    .global-icon{display:grid;width:28px;height:28px;place-items:center;border:1px solid transparent;border-radius:2px;background:transparent;color:#4f471f}
    .global-icon:hover{border-color:#c2ad4d;background:#fff0a9}
    .global-search{display:flex;width:min(320px,28vw);height:27px;align-items:center;border:1px solid #baa64a;border-radius:2px;background:#fff9d8;padding:0 7px;gap:5px}
    .global-search input{min-width:0;flex:1;border:0;outline:0;background:transparent;font-size:12px}
    .user-button{display:flex;height:29px;align-items:center;gap:7px;border:1px solid transparent;border-radius:2px;background:transparent;padding:0 7px}
    .user-button:hover{border-color:#c2ad4d;background:#fff0a9}
    .user-avatar{display:grid;width:20px;height:20px;place-items:center;border-radius:50%;background:#74682c;color:#fff;font-size:9px;font-weight:700}

    .section-bar{display:flex;min-width:0;align-items:stretch;border-bottom:1px solid var(--line);background:#fafafa;padding:0 8px}
    .section-tab{display:flex;align-items:center;border:0;border-right:1px solid #e3e3e3;background:transparent;padding:0 14px;color:#45484b;white-space:nowrap}
    .section-tab:hover{background:#f0f1f2}
    .section-tab.active{border-bottom:3px solid #c6a91e;background:#fff;color:#1f2123;font-weight:700}
    .section-tab.compact{padding:0 10px}

    .shell{display:grid;min-height:0;grid-template-columns:206px minmax(0,1fr)}
    .function-panel{display:flex;min-height:0;flex-direction:column;border-right:1px solid var(--line);background:#f5f6f7}
    .function-title{padding:16px 14px 8px;color:#6d7176;font-size:11px;font-weight:700;text-transform:uppercase}
    .function-panel nav{display:grid;padding:0 5px;gap:2px}
    .nav-link{display:flex;min-height:32px;align-items:center;gap:8px;border:0;border-radius:2px;background:transparent;padding:0 9px;text-align:left}
    .nav-link:hover{background:#e8eaed}
    .nav-link.active{background:#dce8f2;color:#174c77;font-weight:700}
    .nav-icon{display:grid;width:18px;height:18px;place-items:center;color:#5d636a;font-size:12px}
    .panel-info{margin:auto 10px 10px;border-top:1px solid var(--line-soft);padding:10px 4px 0;color:var(--muted);font-size:11px;line-height:1.5}
    .panel-info b{display:block;color:#42464a;font-size:12px}

    .workspace{position:relative;min-width:0;min-height:0;overflow:auto;background:#fff}
    .form-tabs{position:sticky;z-index:8;top:0;display:flex;height:31px;align-items:flex-end;border-bottom:1px solid var(--line);background:#e8eaed;padding-left:7px}
    .form-tab{display:flex;height:27px;max-width:360px;align-items:center;gap:8px;border:1px solid var(--line);border-bottom:0;border-radius:3px 3px 0 0;background:#f2f3f4;padding:0 10px;color:#4c5055}
    .form-tab.active{height:29px;background:#fff;color:#232528;font-weight:700}
    .form-tab span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .tab-close{border:0;background:transparent;color:#777;padding:0 2px;font-size:15px}
    #content{min-width:850px;padding:15px 18px 42px}
    .status-bar{display:flex;align-items:center;gap:14px;border-top:1px solid var(--line);background:#eceef0;padding:0 9px;color:#555b61;font-size:11px}
    .status-bar .ready{color:var(--ok)}
    .status-spacer{flex:1}

    /* Стандартные элементы формы */
    h1{margin:0;font-size:22px;line-height:1.2;font-weight:400}
    h2{margin:0;font-size:16px;font-weight:700}
    h3{margin:0;font-size:13px;font-weight:700}
    p{margin:0}
    .form-heading{display:flex;min-height:34px;align-items:center;gap:8px;margin-bottom:7px}
    .form-heading .favorite{border:0;background:transparent;color:#a88200;font-size:20px;line-height:1}
    .breadcrumb{margin-left:auto;color:var(--muted);font-size:11px}

    .command-bar{display:flex;min-height:36px;align-items:center;gap:6px;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);background:#f5f6f7;padding:4px 5px;margin:0 0 10px}
    .command-separator{width:1px;height:22px;margin:0 2px;background:#d2d5d8}
    .cmd{display:inline-flex;min-height:27px;align-items:center;justify-content:center;gap:6px;border:1px solid #b9bdc2;border-radius:var(--radius);background:linear-gradient(#fff,#f1f2f3);padding:0 10px;white-space:nowrap}
    .cmd:hover{background:#fff}
    .cmd.primary{border-color:var(--yellow-line);background:linear-gradient(#ffe98a,#f2d35a);font-weight:700}
    .cmd.primary:hover{background:#ffe889}
    .cmd.flat{border-color:transparent;background:transparent}
    .cmd.flat:hover{border-color:#c7cbd0;background:#fff}
    .cmd.linklike{border-color:transparent;background:transparent;color:var(--link)}
    .cmd.linklike:hover{text-decoration:underline}
    .cmd:disabled{cursor:default;opacity:.55}
    .cmd .ico{width:14px;color:#5b6268;text-align:center}
    .cmd.primary .ico{color:#5c4b00}

    .params{display:grid;align-items:end;margin-bottom:8px;gap:7px 12px;grid-template-columns:108px minmax(230px,1.3fr) 66px 116px 88px minmax(220px,1fr) auto}
    .field-label{align-self:center;text-align:right;color:#484c50}
    .field{position:relative;display:flex;height:28px;min-width:0;align-items:center;border:1px solid #aeb3b8;border-radius:2px;background:#fff}
    .field:focus-within{border-color:#3984bd;box-shadow:0 0 0 1px #9bc5e5}
    .field input,.field select{min-width:0;height:26px;flex:1;border:0;outline:0;background:transparent;padding:0 7px}
    .field select{appearance:none;padding-right:26px}
    .field-button{display:grid;width:25px;height:25px;place-items:center;border:0;border-left:1px solid #d2d5d8;background:#f4f5f6;color:#5d6369}
    .field-button:hover{background:#e7e9eb}
    .check-field{display:flex;min-height:28px;align-items:center;gap:6px;white-space:nowrap}
    .check-field input{accent-color:#2d79b0}
    .params-advanced{grid-column:1/-1;display:flex;align-items:center;gap:8px;padding-left:120px;color:#666b70;font-size:12px}
    .params-advanced button{border:0;background:transparent;color:var(--link);padding:0}

    .info-group{margin:8px 0 10px;border:1px solid var(--line);border-radius:2px;background:#fff}
    .info-group-title{display:flex;min-height:28px;align-items:center;gap:7px;border-bottom:1px solid var(--line-soft);background:#f5f6f7;padding:0 8px;font-weight:700}
    .info-group-title button{border:0;background:transparent;padding:0;color:#4f555b}
    .source-state{display:grid;grid-template-columns:160px minmax(260px,1fr) 190px minmax(240px,1fr);gap:0;border-bottom:1px solid var(--line-soft)}
    .source-state:last-child{border-bottom:0}
    .source-state>*{min-height:31px;padding:7px 9px;border-right:1px solid var(--line-soft)}
    .source-state>*:last-child{border-right:0}
    .source-state .label{background:#fafafa;color:#575c61}
    .state-ok{color:var(--ok)}
    .state-warn{color:var(--warn)}

    .totals{display:grid;margin:8px 0 9px;border:1px solid var(--line);background:#fafafa;grid-template-columns:repeat(5,minmax(130px,1fr))}
    .total-cell{min-height:52px;border-right:1px solid var(--line);padding:7px 10px}
    .total-cell:last-child{border-right:0}
    .total-cell span{display:block;color:var(--muted);font-size:11px}
    .total-cell b{display:block;margin-top:3px;font-size:16px;font-weight:400}
    .total-cell strong{font-size:17px}
    .total-cell.warn b{color:var(--warn);font-weight:700}
    .total-cell.ok b{color:var(--ok);font-weight:700}

    .report-tools{display:flex;align-items:center;gap:7px;margin:5px 0}
    .report-tools .label{margin-right:2px;color:#555a60}
    .segment{display:flex}
    .segment button{min-height:26px;border:1px solid #b8bdc2;border-right:0;background:#fff;padding:0 9px}
    .segment button:first-child{border-radius:2px 0 0 2px}
    .segment button:last-child{border-right:1px solid #b8bdc2;border-radius:0 2px 2px 0}
    .segment button.active{background:var(--select-strong);color:#164d77;font-weight:700}
    .mini-search{display:flex;width:240px;height:27px;align-items:center;margin-left:auto;border:1px solid #b4b9be;background:#fff;padding:0 6px;gap:5px}
    .mini-search input{min-width:0;flex:1;border:0;outline:0}

    .table-box{border:1px solid #aeb3b8;background:#fff;overflow:auto}
    table{width:100%;border-collapse:collapse}
    .data-table{min-width:1050px;font-size:12px}
    .data-table th{position:sticky;z-index:2;top:0;height:38px;border-right:1px solid #bfc4c8;border-bottom:1px solid #aeb3b8;background:linear-gradient(#f8f9fa,#e8eaec);padding:4px 7px;color:#3e4348;text-align:left;font-weight:400;white-space:normal}
    .data-table th:last-child{border-right:0}
    .data-table td{height:32px;border-right:1px solid #e0e2e4;border-bottom:1px solid #d9dcdf;padding:4px 7px;vertical-align:middle}
    .data-table td:last-child{border-right:0}
    .data-table tbody tr:hover>td{background:#f2f7fb}
    .data-table tbody tr.selected>td{background:var(--select)}
    .data-table .num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
    .data-table .center{text-align:center}
    .data-table .muted{color:var(--muted)}
    .tree-cell{display:flex;min-width:245px;align-items:center;gap:5px}
    .tree-toggle{display:grid;width:17px;height:19px;flex:0 0 auto;place-items:center;border:0;background:transparent;color:#4f555b;font-size:11px}
    .tree-indent{width:23px;flex:0 0 auto}
    .company-link,.doc-link{border:0;background:transparent;color:var(--link);padding:0;text-align:left}
    .company-link:hover,.doc-link:hover{text-decoration:underline}
    .question-row td{background:#fcfcfc;color:#4d5257}
    .question-row .tree-cell{padding-left:20px}
    .question-row.open td:first-child{box-shadow:inset 3px 0 0 #d09929}
    .question-row.resolved td:first-child{box-shadow:inset 3px 0 0 #4c9561}
    .status{display:inline-flex;min-height:20px;align-items:center;gap:5px;border:1px solid transparent;border-radius:10px;padding:1px 7px;white-space:nowrap;font-size:11px}
    .status.warn{border-color:#e1c982;background:var(--warn-bg);color:#78520e}
    .status.danger{border-color:#e2a8a3;background:var(--danger-bg);color:#87322e}
    .status.ok{border-color:#acd0b4;background:var(--ok-bg);color:#246537}
    .status.neutral{border-color:#c9cdd1;background:#f3f4f5;color:#555b60}
    .small-note{margin-top:5px;color:var(--muted);font-size:11px}

    /* Детальная форма */
    .detail-headline{display:flex;align-items:flex-start;gap:16px;margin:0 0 8px}
    .back-link{display:inline-flex;align-items:center;gap:4px;border:0;background:transparent;color:var(--link);padding:5px 0}
    .detail-title{flex:1}
    .detail-title h1{margin-bottom:3px}
    .detail-title p{color:var(--muted);font-size:12px}
    .compact-fields{display:grid;grid-template-columns:96px minmax(260px,1fr) 72px minmax(180px,.7fr);gap:7px 10px;margin:8px 0 9px;align-items:center}
    .compact-fields .field-label{text-align:right}
    .read-field{min-height:27px;border:1px solid #c1c5c9;background:#f8f8f8;padding:5px 7px}
    .notification{display:flex;align-items:flex-start;gap:9px;border:1px solid #d7bd6c;background:#fff7dc;padding:8px 10px;margin:7px 0}
    .notification.ok{border-color:#a9cab1;background:#edf6ef}
    .notification.danger{border-color:#d8a09b;background:#fcebea}
    .notification-icon{display:grid;width:19px;height:19px;flex:0 0 auto;place-items:center;border-radius:50%;background:#b98118;color:#fff;font-size:11px;font-weight:700}
    .notification.ok .notification-icon{background:var(--ok)}
    .notification.danger .notification-icon{background:var(--danger)}
    .notification b{display:block;margin-bottom:2px}
    .notification p{color:#555b60;font-size:12px}
    .form-pages{display:flex;height:31px;align-items:flex-end;border-bottom:1px solid #aeb3b8;margin:9px 0 0;padding-left:5px}
    .page-tab{height:28px;border:1px solid transparent;border-bottom:0;background:transparent;padding:0 12px;color:#51565b}
    .page-tab:hover{background:#f3f4f5}
    .page-tab.active{border-color:#aeb3b8;background:#fff;color:#232629;font-weight:700}
    .page-body{padding-top:8px}
    .section-actions{display:flex;align-items:center;gap:6px;margin-bottom:6px}
    .section-actions .right{margin-left:auto}
    .empty-state{display:grid;min-height:180px;place-items:center;text-align:center;color:#5e6469}
    .empty-state b{display:block;margin-bottom:5px;color:var(--ok);font-size:15px}

    .act-layout{display:grid;grid-template-columns:minmax(700px,1fr) 250px;gap:13px}
    .act-sheet{border:1px solid #9fa4a9;background:#fff;padding:22px 28px;box-shadow:0 2px 8px rgba(30,35,40,.08)}
    .act-sheet header{text-align:center}
    .act-sheet h2{font-size:17px}
    .act-sheet header p{margin-top:3px;color:#555}
    .act-sheet table{margin-top:17px;font-size:11px}
    .act-sheet th,.act-sheet td{border:1px solid #777;padding:5px 6px;text-align:left}
    .act-sheet .num{text-align:right}
    .act-sheet .act-total{font-weight:700}
    .act-conclusion{margin:16px 0;line-height:1.55}
    .signatures{display:grid;margin-top:30px;grid-template-columns:1fr 1fr;gap:34px}
    .signature-line{margin-top:25px;border-top:1px solid #666;padding-top:3px;color:#777;font-size:10px}
    .act-side{border:1px solid var(--line);background:#f7f8f9;padding:10px}
    .act-side h3{margin-bottom:8px}
    .act-side dl{margin:0}
    .act-side dt{margin-top:9px;color:var(--muted);font-size:11px}
    .act-side dd{margin:2px 0 0}

    /* Диалоги */
    .overlay{position:fixed;z-index:50;inset:0;display:grid;place-items:center;background:rgba(30,34,38,.32);padding:24px}
    .dialog{display:flex;width:min(900px,calc(100vw - 48px));max-height:calc(100vh - 48px);flex-direction:column;border:1px solid #858b91;border-radius:3px;background:#fff;box-shadow:var(--shadow)}
    .dialog.small{width:min(560px,calc(100vw - 48px))}
    .dialog-title{display:flex;min-height:38px;align-items:center;gap:8px;border-bottom:1px solid #b7bbc0;background:#e9ebed;padding:0 10px}
    .dialog-title h2{flex:1;font-size:14px}
    .dialog-close{display:grid;width:26px;height:25px;place-items:center;border:1px solid transparent;background:transparent;font-size:18px}
    .dialog-close:hover{border-color:#b8bdc2;background:#fff}
    .dialog-body{min-height:0;overflow:auto;padding:12px}
    .dialog-footer{display:flex;min-height:45px;align-items:center;justify-content:flex-end;gap:7px;border-top:1px solid #c6cace;background:#f4f5f6;padding:6px 9px;flex-wrap:wrap}
    .dialog-footer .footer-note{margin-right:auto;color:#6a6f74;font-size:11px}
    .dialog-group{margin-bottom:12px;border:1px solid #c3c7cb}
    .dialog-group-title{min-height:27px;border-bottom:1px solid #d3d6d9;background:#f4f5f6;padding:5px 8px;font-weight:700}
    .dialog-group-content{padding:9px}
    .finding{display:grid;grid-template-columns:125px 1fr;gap:6px 10px}
    .finding dt{color:#62676c}
    .finding dd{margin:0}
    .comparison{font-size:12px}
    .comparison th,.comparison td{border:1px solid #c4c8cc;padding:6px 8px;text-align:left}
    .comparison th{background:#f2f3f4;font-weight:400}
    .comparison td strong{display:block}
    .recommendation{display:flex;gap:8px;border-left:3px solid #c79521;background:#fff9e7;padding:8px 9px}
    .comment-label{display:block;margin-bottom:4px;color:#50555a}
    textarea{width:100%;min-height:66px;resize:vertical;border:1px solid #adb2b7;padding:6px 7px}
    textarea.error{border-color:var(--danger);background:#fff7f6}
    .validation{display:none;margin-top:4px;color:var(--danger);font-size:11px}
    .validation.visible{display:block}
    .result-box{border-left:3px solid var(--ok);background:#eef7f0;padding:8px 10px}
    .result-box.pending{border-left-color:#c18a22;background:#fff8e5}
    .result-box b{display:block;margin-bottom:3px}
    .radio-list{display:grid;gap:8px}
    .radio-list label{display:flex;align-items:flex-start;gap:7px}
    .radio-list input{margin-top:2px;accent-color:#2c76aa}
    .progress{height:8px;border:1px solid #afb4b9;background:#fff;overflow:hidden}
    .progress i{display:block;width:0;height:100%;background:#5a96c2;transition:width .35s}
    .sync-steps{display:grid;margin:10px 0;gap:6px}
    .sync-step{display:flex;align-items:center;gap:8px;border:1px solid #d0d3d6;background:#fafafa;padding:7px 8px}
    .sync-step .step-icon{display:grid;width:21px;height:21px;place-items:center;border-radius:50%;background:#dfe3e6;color:#555;font-size:10px}
    .sync-step.processing{background:#f1f7fc}
    .sync-step.processing .step-icon{background:#4c8dbb;color:#fff}
    .sync-step.done .step-icon{background:var(--ok);color:#fff}
    .sync-step div{flex:1}
    .sync-step b,.sync-step small{display:block}
    .sync-step small{color:var(--muted)}
    .choice-search{display:flex;height:29px;align-items:center;gap:6px;border:1px solid #adb2b7;background:#fff;padding:0 7px;margin-bottom:8px}
    .choice-search input{min-width:0;flex:1;border:0;outline:0;background:transparent}
    .choice-table-box{max-height:370px;overflow:auto;border:1px solid #aeb3b8}
    .choice-table-box .data-table{min-width:680px}
    .choice-table-box .data-table th{top:0}
    .choice-empty{display:none;padding:18px;color:var(--muted);text-align:center}
    .choice-empty.visible{display:block}

    .more-menu{position:fixed;z-index:30;min-width:235px;border:1px solid #8f959a;border-radius:2px;background:#fff;box-shadow:0 5px 18px rgba(30,35,40,.2);padding:4px}
    .more-menu button{display:block;width:100%;min-height:29px;border:0;background:transparent;padding:0 9px;text-align:left}
    .more-menu button:hover{background:var(--select)}
    .menu-separator{height:1px;margin:4px;background:#dddfe2}
    .toast{position:fixed;z-index:80;right:18px;bottom:38px;display:flex;max-width:430px;align-items:flex-start;gap:8px;border:1px solid #8d949a;border-radius:2px;background:#fff;padding:10px 12px;box-shadow:var(--shadow)}
    .toast-icon{display:grid;width:19px;height:19px;flex:0 0 auto;place-items:center;border-radius:50%;background:var(--ok);color:#fff;font-size:11px;font-weight:700}
    .toast.warn .toast-icon{background:var(--warn)}
    .toast b{display:block;margin-bottom:2px}
    .toast small{display:block;color:var(--muted)}

    /* Визуальная модель управляемой формы модуля Диадока для 1С */
    .application{grid-template-rows:34px 1fr 22px;background:#e9eaec}
